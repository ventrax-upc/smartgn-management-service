# Replace placeholders in a private copy, then import it into Render Environment.
SPRING_PROFILES_ACTIVE=render
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DIRECT_NEON_HOST:5432/smartgn-management-db?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=YOUR_MANAGEMENT_NEON_ROLE
SPRING_DATASOURCE_PASSWORD=YOUR_MANAGEMENT_NEON_PASSWORD
JWT_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_IN_BOTH_SERVICES
DEVICE_CREDENTIAL_KEY=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
DB_POOL_SIZE=5
JWT_ISSUER=smartgn-iam-service
JWT_AUDIENCE=
ALLOWED_ORIGINS=
CACHE_ENABLED=false
TELEMETRY_ENABLED=false
BROKER_ENABLED=false
WORKER_ENABLED=false
