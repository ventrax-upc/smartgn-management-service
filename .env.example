# Copy to .env and set secrets, or use scripts/start-local.ps1 to generate local values.
PORT=8081
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/smartgn-management-db
SPRING_DATASOURCE_USERNAME=smartgn_management
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-password
# Must match the existing IAM service. Its application-local.yml has a development-only key.
JWT_SECRET=replace-with-the-same-secret-as-IAM-at-least-32-bytes
JWT_ISSUER=smartgn-iam-service
# Existing IAM does not emit aud. Set this only after IAM introduces that claim.
JWT_AUDIENCE=
DEVICE_CREDENTIAL_KEY=replace-with-base64-encoded-32-random-bytes
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token
SIMULATOR_ADMIN_TOKEN=replace-with-a-different-random-token
TELEMETRY_BASE_URL=http://telemetry:8090
EMQX_API_URL=http://broker:18083/api/v5
EMQX_API_KEY=replace-with-a-random-api-key
EMQX_API_SECRET=replace-with-a-random-api-secret
EMQX_PASSWORD=replace-with-a-dashboard-password
REDIS_HOST=redis
REDIS_PORT=6379
ALLOWED_ORIGINS=http://localhost:4200
MAINTENANCE_RETENTION_YEARS=5
AUDIT_RETENTION_YEARS=5
